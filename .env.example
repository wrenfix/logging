# Copy to .env before the first start:  cp .env.example .env
# Docker Compose loads .env from this directory automatically. Do NOT commit .env
# (.gitignore already excludes it).

# ---------------------------------------------------------------------------
# Grafana
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
# REQUIRED. Compose aborts with a clear error if this is unset or empty.
# Generate one:  openssl rand -base64 24
# NOTE: Grafana only applies this when it CREATES the admin user, i.e. on a fresh
# grafana-data volume. If you skip the teardown in README "First run" step 0, the
# old password stays in force and this value is silently ignored.
GRAFANA_ADMIN_PASSWORD=

# Where the Grafana UI is published on the host.
# 127.0.0.1 = reachable only from this machine (default, fail-closed).
# 0.0.0.0    = reachable from your LAN. Only behind a firewall or reverse proxy.
# NOTE: the stack this replaces published Grafana on 0.0.0.0:3000. If you reach
# this machine over the network, you MUST change this or Grafana goes dark for
# you with no error anywhere - the container will look perfectly healthy.
GRAFANA_BIND_IP=127.0.0.1
GRAFANA_PORT=24680
# Must match how you actually reach Grafana, or share/redirect links break.
GRAFANA_ROOT_URL=http://localhost:24680
# debug | info | warn | error - raise to debug when troubleshooting provisioning.
GRAFANA_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Alloy debug UI (component graph, live debugging, /metrics)
# It has NO authentication. Keep it on loopback.
# ---------------------------------------------------------------------------
ALLOY_UI_BIND_IP=127.0.0.1
ALLOY_UI_PORT=12345

# ---------------------------------------------------------------------------
# Misc
# Applied to all three containers so log timestamps and the Grafana UI agree.
# ---------------------------------------------------------------------------
TZ=UTC

# Retention is NOT set here. It is written literally as `retention_period: 720h`
# in config/loki/loki.yaml. The Loki container does not run with
# -config.expand-env, so a stray '$' in that file cannot become a boot failure.
