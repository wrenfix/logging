{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Find and read specific log lines. The filters at the top cover everyday work; the collapsed raw LogQL row at the bottom handles what they cannot express, notably excluding text. Auto-refresh is off on purpose so results hold still while you read them.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "title": "Container Logs (overview)",
      "tooltip": "Volume trends and per-container health, carrying the current filters and time range",
      "type": "link",
      "url": "/d/container-logs/container-logs?${compose_project:queryparam}&${compose_service:queryparam}&${container:queryparam}&var-contains=${contains:percentencode}"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "A time navigator, not a chart to study: drag-select a spike and the log list below follows. Stacked by the severity Loki detected.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "drawStyle": "bars",
            "fillOpacity": 85,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 0,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "normal" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "min": 0,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fatal" },
            "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "trace" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unknown" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#909090", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 5, "w": 20, "x": 0, "y": 0 },
      "id": 1,
      "maxDataPoints": 100,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": true, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum by (detected_level) (count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\", stream=~\"$stream\"} | detected_level=~\"$level\" |~ \"(?i)(?:$contains)\" [$__auto]))",
          "legendFormat": "{{detected_level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Severity over time",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "How many lines match the current filters across the whole time range. The list below stops at 2000 lines: when this number turns orange it has passed that cap and you are not seeing every match - narrow the filters or shorten the time range.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 0,
          "mappings": [],
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "orange", "value": 2001 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\", stream=~\"$stream\"} | detected_level=~\"$level\" |~ \"(?i)(?:$contains)\" [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Matching lines",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Newest first, one line per entry. Lines are not labelled with their container - narrow the Container filter above to attribute them, or click a line to open it beside the list with the full text and every label and structured metadata field (container_id, image). Keep scrolling at the bottom to load older lines.",
      "gridPos": { "h": 17, "w": 24, "x": 0, "y": 5 },
      "id": 3,
      "options": {
        "dedupStrategy": "none",
        "detailsMode": "sidebar",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showLabels": false,
        "showLevel": true,
        "showLogContextToggle": true,
        "showTime": true,
        "sortOrder": "Descending",
        "syntaxHighlighting": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\", stream=~\"$stream\"} | detected_level=~\"$level\" |~ \"(?i)(?:$contains)\"",
          "maxLines": 2000,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Logs",
      "type": "logs"
    },
    {
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 4,
      "panels": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "description": "Runs the `Advanced LogQL` box at the top verbatim. The filters above do not apply here.\n\nThis is the only place you can EXCLUDE text: an empty `!=` matches nothing, so exclusion cannot be offered as a filter box.\n\n    {job=\"docker\"} != \"/health\" != \"Request Completed\"\n    {job=\"docker\"} !~ \"(?i)debug|trace\"\n    {container=\"logging-grafana\"} | logfmt | level=\"error\"\n    {job=\"docker\"} | container_id=\"de64eeed9d77\"\n\nA stream selector such as {job=\"docker\"} is always required. Metric queries (sum, rate) belong in Explore, not in a logs panel.",
          "gridPos": { "h": 18, "w": 24, "x": 0, "y": 23 },
          "id": 5,
          "options": {
            "dedupStrategy": "none",
            "detailsMode": "sidebar",
            "enableInfiniteScrolling": true,
            "enableLogDetails": true,
            "fontSize": "small",
            "prettifyLogMessage": false,
            "showCommonLabels": false,
            "showControls": true,
            "showLabels": false,
            "showLevel": true,
            "showLogContextToggle": true,
            "showTime": true,
            "sortOrder": "Descending",
            "syntaxHighlighting": true,
            "wrapLogMessage": false
          },
          "targets": [
            {
              "datasource": { "type": "loki", "uid": "loki" },
              "direction": "backward",
              "editorMode": "code",
              "expr": "${logql:raw}",
              "maxLines": 2000,
              "queryType": "range",
              "refId": "A"
            }
          ],
          "title": "Raw LogQL result",
          "type": "logs"
        }
      ],
      "title": "Advanced: raw LogQL",
      "type": "row"
    }
  ],
  "preload": false,
  "refresh": "",
  "schemaVersion": 42,
  "tags": ["docker", "logs", "loki", "search"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({job=\"docker\"},compose_project)",
        "description": "Docker Compose project. Containers started outside Compose have no value; allValue is '.*' (not '.+') so they stay visible under All.",
        "includeAll": true,
        "label": "Compose project",
        "multi": true,
        "name": "compose_project",
        "options": [],
        "query": {
          "label": "compose_project",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"docker\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({job=\"docker\", compose_project=~\"$compose_project\"},compose_service)",
        "description": "Docker Compose service, narrowed by the project above.",
        "includeAll": true,
        "label": "Compose service",
        "multi": true,
        "name": "compose_service",
        "options": [],
        "query": {
          "label": "compose_service",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"docker\", compose_project=~\"$compose_project\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\"},container)",
        "description": "Values come from what is actually in Loki, so containers that no longer exist stay listed for as long as their logs are retained.",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "options": [],
        "query": {
          "label": "container",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] },
        "description": "Severity from Loki's detected_level structured metadata, not a regex guess at the line text. Lines Loki cannot classify land in `unknown`, so picking specific levels hides them.",
        "includeAll": true,
        "label": "Level",
        "multi": true,
        "name": "level",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "fatal", "value": "fatal" },
          { "selected": false, "text": "critical", "value": "critical" },
          { "selected": false, "text": "error", "value": "error" },
          { "selected": false, "text": "warn", "value": "warn" },
          { "selected": false, "text": "info", "value": "info" },
          { "selected": false, "text": "debug", "value": "debug" },
          { "selected": false, "text": "trace", "value": "trace" },
          { "selected": false, "text": "unknown", "value": "unknown" }
        ],
        "query": "fatal,critical,error,warn,info,debug,trace,unknown",
        "type": "custom"
      },
      {
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] },
        "description": "stdout or stderr. Plenty of programs write every failure to stderr and nothing else, so selecting stderr alone is often the fastest way to find one.",
        "includeAll": true,
        "label": "Stream",
        "multi": true,
        "name": "stream",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "stdout", "value": "stdout" },
          { "selected": false, "text": "stderr", "value": "stderr" }
        ],
        "query": "stdout,stderr",
        "type": "custom"
      },
      {
        "current": { "text": "", "value": "" },
        "description": "Case-insensitive RE2 regex matched against the log line; `foo|bar` for alternatives. Empty matches everything, so this box is always safe to clear. Do not type a double quote - it is interpolated into a LogQL string literal verbatim and will break every panel. To EXCLUDE text, open the Advanced row at the bottom - exclusion cannot be a filter box because an empty one would match nothing.",
        "label": "Contains (regex)",
        "name": "contains",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox"
      },
      {
        "current": { "text": "{job=\"docker\"}", "value": "{job=\"docker\"}" },
        "description": "A complete LogQL expression for the Advanced row at the bottom of this dashboard. Independent of every filter above.",
        "label": "Advanced LogQL",
        "name": "logql",
        "options": [{ "selected": true, "text": "{job=\"docker\"}", "value": "{job=\"docker\"}" }],
        "query": "{job=\"docker\"}",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["1m", "5m", "15m", "30m", "1h"]
  },
  "timezone": "browser",
  "title": "Log Search",
  "uid": "log-search",
  "version": 2,
