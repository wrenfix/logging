{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Is the system healthy, and if not, where? Volume and severity for every Docker container on this host. Reading and searching individual lines is the Log Search dashboard's job.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "title": "Log Search",
      "tooltip": "Search and read full log lines, carrying the current filters and time range",
      "type": "link",
      "url": "/d/log-search/log-search?${compose_project:queryparam}&${compose_service:queryparam}&${container:queryparam}&var-contains=${contains:percentencode}"
    }
  ],
  "panels": [
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Lines Loki classified as critical, fatal, error or warn, read from detected_level rather than matched as text.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum(count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} | detected_level=~\"critical|fatal|error|warn\" |~ \"(?i)(?:$contains)\" [$__range])) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error & warn lines",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "The same lines as the card on the left, divided by every line in range. This is the range-independent read, and the only card that changes colour: under 1% is normal, over 5% is red.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 2,
          "mappings": [],
          "max": 1,
          "min": 0,
          "noValue": "0%",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 0.01 },
              { "color": "red", "value": 0.05 }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "(sum(count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} | detected_level=~\"critical|fatal|error|warn\" |~ \"(?i)(?:$contains)\" [$__range])) or vector(0)) / sum(count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} |~ \"(?i)(?:$contains)\" [$__range]))",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Error & warn share",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "How many distinct containers produced at least one critical, fatal, error or warn line - one broken service, or something they all share.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "noValue": "0",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "text", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "percentChangeColorMode": "standard",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showPercentChange": false,
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "count(sum by (container) (count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} | detected_level=~\"critical|fatal|error|warn\" |~ \"(?i)(?:$contains)\" [$__range]))) or vector(0)",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Containers affected",
      "type": "stat"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Log lines over time, coloured by the severity Loki detected. The axis is logarithmic so a single error line stays visible next to thousands of info lines.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "drawStyle": "line",
            "fillOpacity": 0,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "log": 10, "type": "log" },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "fatal" },
            "properties": [{ "id": "color", "value": { "fixedColor": "dark-red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "critical" },
            "properties": [{ "id": "color", "value": { "fixedColor": "semi-dark-red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warn" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "trace" },
            "properties": [{ "id": "color", "value": { "fixedColor": "purple", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "unknown" },
            "properties": [{ "id": "color", "value": { "fixedColor": "#909090", "mode": "fixed" } }]
          }
        ]
      },
      "gridPos": { "h": 11, "w": 16, "x": 0, "y": 4 },
      "id": 4,
      "options": {
        "legend": { "calcs": [], "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "hideZeros": true, "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "sum by (detected_level) (count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} |~ \"(?i)(?:$contains)\" [$__auto]))",
          "legendFormat": "{{detected_level}}",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Log volume by severity",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "The busiest containers in range. This is a load ranking, not a health ranking. Click a name to open it in Log Search.",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "#909090", "mode": "fixed" },
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" },
            "filterable": false,
            "inspect": false
          },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#909090", "value": null }] }
        },
        "overrides": [
          {
            "matcher": { "id": "byType", "options": "number" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "mode": "gradient", "type": "gauge", "valueDisplayMode": "text" } },
              { "id": "min", "value": 0 },
              { "id": "unit", "value": "short" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Container" },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "targetBlank": false,
                    "title": "Open in Log Search",
                    "url": "/d/log-search/log-search?${__url_time_range}&${compose_project:queryparam}&${compose_service:queryparam}&var-container=${__data.fields.Container}&var-contains=${contains:percentencode}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 11, "w": 8, "x": 16, "y": 4 },
      "id": 5,
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [{ "desc": true, "displayName": "Lines" }]
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "editorMode": "code",
          "expr": "topk(10, sum by (container) (count_over_time({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} |~ \"(?i)(?:$contains)\" [$__range])))",
          "legendFormat": "{{container}}",
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Busiest containers (top 10)",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": { "Time": true },
            "indexByName": {},
            "renameByName": { "Value #A": "Lines", "container": "Container" }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Critical, fatal, error and warn lines, newest first. Click a line to expand it with the full text and all labels.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 15 },
      "id": 6,
      "links": [
        {
          "targetBlank": false,
          "title": "Open in Log Search",
          "url": "/d/log-search/log-search?${__url_time_range}&${compose_project:queryparam}&${compose_service:queryparam}&${container:queryparam}&var-contains=${contains:percentencode}&var-level=fatal&var-level=critical&var-level=error&var-level=warn"
        }
      ],
      "options": {
        "dedupStrategy": "none",
        "detailsMode": "sidebar",
        "enableInfiniteScrolling": true,
        "enableLogDetails": true,
        "fontSize": "small",
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showControls": true,
        "showLabels": false,
        "showLevel": true,
        "showLogContextToggle": true,
        "showTime": true,
        "sortOrder": "Descending",
        "syntaxHighlighting": true,
        "wrapLogMessage": false
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "direction": "backward",
          "editorMode": "code",
          "expr": "{job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\", container=~\"$container\"} | detected_level=~\"critical|fatal|error|warn\" |~ \"(?i)(?:$contains)\"",
          "maxLines": 200,
          "queryType": "range",
          "refId": "A"
        }
      ],
      "title": "Recent problems",
      "type": "logs"
    }
  ],
  "preload": false,
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": ["docker", "logs", "loki"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({job=\"docker\"},compose_project)",
        "description": "Docker Compose project. Containers started outside Compose have no value; allValue is '.*' (not '.+') so they stay visible under All.",
        "includeAll": true,
        "label": "Compose project",
        "multi": true,
        "name": "compose_project",
        "options": [],
        "query": {
          "label": "compose_project",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"docker\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({job=\"docker\", compose_project=~\"$compose_project\"},compose_service)",
        "description": "Docker Compose service, narrowed by the project above.",
        "includeAll": true,
        "label": "Compose service",
        "multi": true,
        "name": "compose_service",
        "options": [],
        "query": {
          "label": "compose_service",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"docker\", compose_project=~\"$compose_project\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] },
        "datasource": { "type": "loki", "uid": "loki" },
        "definition": "label_values({job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\"},container)",
        "description": "Values come from what is actually in Loki, so containers that no longer exist stay listed for as long as their logs are retained.",
        "includeAll": true,
        "label": "Container",
        "multi": true,
        "name": "container",
        "options": [],
        "query": {
          "label": "container",
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "stream": "{job=\"docker\", compose_project=~\"$compose_project\", compose_service=~\"$compose_service\"}",
          "type": 1
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query"
      },
      {
        "current": { "text": "", "value": "" },
        "description": "Case-insensitive RE2 regex matched against the log line; `foo|bar` for alternatives. Empty matches everything, so this box is always safe to clear. Do not type a double quote - it is interpolated into a LogQL string literal verbatim and will break every panel. To EXCLUDE text, use the Advanced raw LogQL row on Log Search.",
        "label": "Contains (regex)",
        "name": "contains",
        "options": [{ "selected": true, "text": "", "value": "" }],
        "query": "",
        "skipUrlSync": false,
        "type": "textbox"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["1m", "5m", "15m", "30m", "1h"]
  },
  "timezone": "browser",
  "title": "Container Logs",
  "uid": "container-logs",
  "version": 2,
  "weekStart": ""
}
